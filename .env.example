# Copy to .env. Local development values only, no secrets.
# Read by dbmate and the database tests.
DATABASE_URL=postgres://petvold:petvold@127.0.0.1:5432/petvold?sslmode=disable
TEST_DATABASE_URL=postgres://petvold:petvold@127.0.0.1:5432/petvold_test?sslmode=disable
# The claims engine's service role, which the store connects with.
# Remove CLAIMS_DATABASE_URL to run the dev server in memory.
CLAIMS_DATABASE_URL=postgres://claims_service:claims_service@127.0.0.1:5432/petvold?sslmode=disable
CLAIMS_TEST_DATABASE_URL=postgres://claims_service:claims_service@127.0.0.1:5432/petvold_test?sslmode=disable
# The access module's service role (ADR 0020). Remove to keep the role settings in memory.
ACCESS_DATABASE_URL=postgres://access_service:access_service@127.0.0.1:5432/petvold?sslmode=disable
ACCESS_TEST_DATABASE_URL=postgres://access_service:access_service@127.0.0.1:5432/petvold_test?sslmode=disable
# The decisioning module's service role (ADR 0021). Remove to keep rule sets in memory.
DECISIONING_DATABASE_URL=postgres://decisioning_service:decisioning_service@127.0.0.1:5432/petvold?sslmode=disable
DECISIONING_TEST_DATABASE_URL=postgres://decisioning_service:decisioning_service@127.0.0.1:5432/petvold_test?sslmode=disable
# The catalog module's service role (ADR 0022). Remove to keep reference data in memory.
CATALOG_DATABASE_URL=postgres://catalog_service:catalog_service@127.0.0.1:5432/petvold?sslmode=disable
CATALOG_TEST_DATABASE_URL=postgres://catalog_service:catalog_service@127.0.0.1:5432/petvold_test?sslmode=disable
# The animals module's service role (ADR 0024). Remove to keep the animal register in memory.
ANIMALS_DATABASE_URL=postgres://animals_service:animals_service@127.0.0.1:5432/petvold?sslmode=disable
ANIMALS_TEST_DATABASE_URL=postgres://animals_service:animals_service@127.0.0.1:5432/petvold_test?sslmode=disable
# The parties module's service role (ADR 0026). Remove to keep parties in memory.
PARTIES_DATABASE_URL=postgres://parties_service:parties_service@127.0.0.1:5432/petvold?sslmode=disable
PARTIES_TEST_DATABASE_URL=postgres://parties_service:parties_service@127.0.0.1:5432/petvold_test?sslmode=disable
# The policies module's service role (ADR 0029). Remove to keep policies in memory.
POLICIES_DATABASE_URL=postgres://policies_service:policies_service@127.0.0.1:5432/petvold?sslmode=disable
POLICIES_TEST_DATABASE_URL=postgres://policies_service:policies_service@127.0.0.1:5432/petvold_test?sslmode=disable
# The communications module's service role (ADR 0032). Remove to keep notices in memory.
COMMUNICATIONS_DATABASE_URL=postgres://communications_service:communications_service@127.0.0.1:5432/petvold?sslmode=disable
COMMUNICATIONS_TEST_DATABASE_URL=postgres://communications_service:communications_service@127.0.0.1:5432/petvold_test?sslmode=disable
