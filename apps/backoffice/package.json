{
  "name": "@petvold/backoffice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The back office for claims handlers and back office staff (ADR 0035).",
  "scripts": {
    "dev": "vite",
    "build": "npm run types && npm run icons && tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "types": "openapi-typescript ../../modules/api/openapi.yaml -o src/api/schema.d.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "e2e": "npm run icons && playwright test",
    "icons": "node scripts/copy-icons.mjs",
    "predev": "npm run icons"
  },
  "dependencies": {
    "@awesome.me/webawesome": "3.14.0",
    "@lit/localize": "0.12.2",
    "lit": "3.3.3",
    "oidc-client-ts": "3.5.0",
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "@playwright/test": "1.64.1",
    "openapi-typescript": "7.13.0",
    "vite": "8.3.5"
  }
}
