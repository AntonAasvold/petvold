# The demo's front (ADR 0041): HTTPS from Let's Encrypt, one shared password,
# and the API beside the back office.
#
# The password is asked for once, at /login, which then sets a cookie. Every
# other page and call needs the cookie. Basic authentication on every request
# would clash with the back office, which sends its demo token in the same
# Authorization header.
{
	admin off
	# No HTTP/3: Compose publishes TCP only, and behind a forwarded port
	# Caddy would advertise UDP on the wrong port.
	servers {
		protocols h1 h2
	}
}

# How Let's Encrypt checks the domain, chosen with DEMO_TLS.
# http: on port 80 or 443 (the default).
(tls-http) {
}

# duckdns: with a TXT record at DuckDNS, so ports 80 and 443 may lead to
# another machine and the demo can be reached on, for example, port 8443.
(tls-duckdns) {
	tls {
		dns duckdns {$DUCKDNS_TOKEN}
	}
}

{$DEMO_DOMAIN} {
	import tls-{$DEMO_TLS:http}
	encode zstd gzip
	header -Server

	# Signed already: document links (ADR 0038) and the fake bank (ADR 0017). And the health check.
	@open path /d/* /provider-notifications/* /health
	handle @open {
		reverse_proxy api:8080
	}

	# route keeps the order as written: the password first, then the cookie and the redirect.
	handle /login {
		route {
			basic_auth {
				{$DEMO_USER} {$DEMO_PASSWORD_HASH}
			}
			header Set-Cookie "petvold_demo={$DEMO_GATE}; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=2592000"
			redir * / 302
		}
	}

	@signedIn header Cookie *petvold_demo={$DEMO_GATE}*
	handle @signedIn {
		@api path /v1/* /openapi.yaml /docs /healthz
		handle @api {
			reverse_proxy api:8080
		}
		# The demo service (docs/teknik/demotjanst.md), which serves its pages from /.
		redir /demo /demo/ 308
		handle_path /demo/* {
			reverse_proxy demo:8790
		}
		handle {
			reverse_proxy web:8080
		}
	}

	handle {
		redir * /login 302
	}
}
