# The back office as static files (ADR 0041). The router uses the history API,
# so every path that is not a file gets index.html.
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header -Server
	try_files {path} /index.html
	file_server
}
