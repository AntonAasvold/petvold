# Example requests for the claims engine. Start the dev server first: npm run dev
#
# Works in VS Code with the REST Client extension (humao.rest-client):
# click "Send Request" above each request. The response of a named request
# (# @name) can be used in later requests.
#
# Each run creates new claims with random ids, so the file can be run again
# and again without restarting the server. Data lives in memory only.
#
# The same examples are on http://localhost:8787/docs.

@base = http://localhost:8787
@handler = dev-handler
@clinic = dev-clinic

###############################################################################
# 1. Pre-approval at the clinic's checkout. Stores nothing.
###############################################################################

POST {{base}}/v1/claim-previews
Authorization: Bearer {{clinic}}
Content-Type: application/json
Accept-Language: sv

{
  "id": "clm_preview",
  "claimNo": "PREVIEW",
  "policyId": "pol_bella",
  "animalId": "ani_bella",
  "market": "SE",
  "currency": "SEK",
  "channel": "clinic_direct",
  "treatmentFrom": "2026-11-11",
  "treatmentTo": "2026-11-11",
  "diagnosisCode": "ORA-OTIT",
  "lines": [
    { "id": "l1", "description": "Examination", "category": "examination", "amount": 65000 },
    { "id": "l2", "description": "Ear flush and medication", "category": "medication", "amount": 335000 }
  ]
}

###############################################################################
# 2. Ear infection: settled automatically.
#    Expected: decision.outcome = approved, payout = 150000 (SEK 1,500).
#    The next ear claim within 125 days has no fixed deductible.
###############################################################################

# @name otit
POST {{base}}/v1/claims
Authorization: Bearer {{clinic}}
Content-Type: application/json
Idempotency-Key: {{$guid}}
Accept-Language: sv

{
  "id": "clm_otit_{{$randomInt 100000 999999}}",
  "claimNo": "EX-OTIT-{{$randomInt 1000 9999}}",
  "policyId": "pol_bella",
  "animalId": "ani_bella",
  "market": "SE",
  "currency": "SEK",
  "channel": "clinic_direct",
  "treatmentFrom": "2026-11-11",
  "treatmentTo": "2026-11-11",
  "diagnosisCode": "ORA-OTIT",
  "lines": [
    { "id": "l1", "description": "Examination", "category": "examination", "amount": 65000 },
    { "id": "l2", "description": "Ear flush and medication", "category": "medication", "amount": 335000 }
  ]
}

###############################################################################
# 3. Cruciate ligament injury: goes to a claims handler.
#    Expected: decision = null, assessment.mode = manual. RIDER = review
#    (rider in the same diagnosis group) and the amount is above the auto-settle limit.
###############################################################################

# @name korsband
POST {{base}}/v1/claims
Authorization: Bearer {{clinic}}
Content-Type: application/json
Idempotency-Key: {{$guid}}
Accept-Language: sv

{
  "id": "clm_korsband_{{$randomInt 100000 999999}}",
  "claimNo": "EX-KORS-{{$randomInt 1000 9999}}",
  "policyId": "pol_bella",
  "animalId": "ani_bella",
  "market": "SE",
  "currency": "SEK",
  "channel": "clinic_direct",
  "treatmentFrom": "2026-11-11",
  "treatmentTo": "2026-11-13",
  "diagnosisCode": "ORT-KORSBAND-V",
  "lines": [
    { "id": "l1", "description": "Examination orthopaedics", "category": "examination", "amount": 85000 },
    { "id": "l2", "description": "X-ray hind legs", "category": "diagnostics", "amount": 290000 },
    { "id": "l3", "description": "Sedation and anaesthesia", "category": "anaesthesia", "amount": 124000 },
    { "id": "l4", "description": "TPLO surgery left", "category": "surgery", "amount": 1240000 },
    { "id": "l5", "description": "Pain relief 10 days", "category": "medication", "amount": 83000 },
    { "id": "l6", "description": "Prescription food", "category": "food", "amount": 42000 }
  ]
}

###############################################################################
# 4. The claims handler looks at the assessment.
###############################################################################

# @name bedomning
GET {{base}}/v1/claims/{{korsband.response.body.claim.id}}/assessment
Authorization: Bearer {{handler}}
Accept-Language: sv

###############################################################################
# 5. The claims handler accepts, with inputHash from the assessment above.
#    If the basis changes before the decision, the response is 409.
###############################################################################

POST {{base}}/v1/claims/{{korsband.response.body.claim.id}}/decisions
Authorization: Bearer {{handler}}
Content-Type: application/json
Idempotency-Key: {{$guid}}

{
  "action": "accept",
  "reason": "The rider covers the right hind leg; the injury is on the left.",
  "expectedInputHash": "{{bedomning.response.body.inputHash}}"
}

###############################################################################
# 6. All decisions for the claim, oldest first.
###############################################################################

GET {{base}}/v1/claims/{{korsband.response.body.claim.id}}/decisions
Authorization: Bearer {{handler}}

###############################################################################
# 7. Annual limit: consumed and remaining for Bella this year.
###############################################################################

GET {{base}}/v1/policies/pol_bella/animals/ani_bella/limits?onDate=2026-11-11
Authorization: Bearer {{handler}}

###############################################################################
# 8. Reassessment, e.g. after a retroactive change to the policy.
#    If the basis has changed, a new decision is made and the ledger books only
#    the difference. After step 5 the cruciate decision has consumed more of the
#    annual limit, so you get 201 with the same payout (difference SEK 0).
#    Run the same reassessment again: the basis is now unchanged and the response is 204.
###############################################################################

POST {{base}}/v1/claims/{{otit.response.body.claim.id}}/reassessments
Authorization: Bearer {{handler}}
Content-Type: application/json
Idempotency-Key: {{$guid}}

{ "reason": "The policy has been changed retroactively." }

###############################################################################
# Error cases
###############################################################################

### Treatment before the policy year starts: rejection is proposed (POLICY_FOUND = fail).
POST {{base}}/v1/claim-previews
Authorization: Bearer {{clinic}}
Content-Type: application/json
Accept-Language: sv

{
  "id": "clm_fore_start",
  "claimNo": "PREVIEW-2",
  "policyId": "pol_bella",
  "animalId": "ani_bella",
  "market": "SE",
  "currency": "SEK",
  "channel": "customer",
  "treatmentFrom": "2026-03-20",
  "treatmentTo": "2026-03-20",
  "diagnosisCode": "GI-ENTERIT",
  "lines": [{ "id": "l1", "description": "Examination", "category": "examination", "amount": 80000 }]
}

### A clinic may not make decisions: 403.
POST {{base}}/v1/claims/{{korsband.response.body.claim.id}}/decisions
Authorization: Bearer {{clinic}}
Content-Type: application/json
Idempotency-Key: {{$guid}}

{ "action": "accept" }

### Without Idempotency-Key: 422.
POST {{base}}/v1/claims/{{korsband.response.body.claim.id}}/decisions
Authorization: Bearer {{handler}}
Content-Type: application/json

{ "action": "accept" }

### Fields not in the contract: 422 with field errors.
POST {{base}}/v1/claim-previews
Authorization: Bearer {{clinic}}
Content-Type: application/json

{ "id": "x", "unknownField": true }

### Unknown claim: 404.
GET {{base}}/v1/claims/clm_does_not_exist
Authorization: Bearer {{handler}}

### Without a token: 401.
GET {{base}}/v1/claims/clm_does_not_exist
