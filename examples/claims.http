# Exempelanrop mot skademotorn. Starta först dev-servern: npm run dev
#
# Fungerar i VS Code med tillägget REST Client (humao.rest-client):
# klicka på "Send Request" ovanför varje anrop. Svaret från ett namngivet
# anrop (# @name) går att använda i senare anrop.
#
# Varje körning skapar nya ärenden med slumpade id:n, så filen kan köras
# om och om igen utan att starta om servern. Data finns bara i minnet.
#
# Samma exempel finns på http://localhost:8787/docs.

@base = http://localhost:8787
@handler = dev-handler
@clinic = dev-clinic

###############################################################################
# 1. Förhandsbesked i klinikens kassa. Sparar ingenting.
###############################################################################

POST {{base}}/v1/claim-previews
Authorization: Bearer {{clinic}}
Content-Type: application/json
Accept-Language: sv

{
  "id": "clm_preview",
  "claimNo": "PREVIEW",
  "policyId": "pol_bella",
  "animalId": "ani_bella",
  "market": "SE",
  "currency": "SEK",
  "channel": "clinic_direct",
  "treatmentFrom": "2026-11-11",
  "treatmentTo": "2026-11-11",
  "diagnosisCode": "ORA-OTIT",
  "lines": [
    { "id": "l1", "description": "Undersökning", "category": "examination", "amount": 65000 },
    { "id": "l2", "description": "Öronsköljning och läkemedel", "category": "medication", "amount": 335000 }
  ]
}

###############################################################################
# 2. Öroninflammation: regleras automatiskt.
#    Väntat: decision.outcome = approved, payout = 150000 (1 500 kr).
#    Nästa öronärende inom 125 dagar får ingen fast självrisk.
###############################################################################

# @name otit
POST {{base}}/v1/claims
Authorization: Bearer {{clinic}}
Content-Type: application/json
Idempotency-Key: {{$guid}}
Accept-Language: sv

{
  "id": "clm_otit_{{$randomInt 100000 999999}}",
  "claimNo": "EX-OTIT-{{$randomInt 1000 9999}}",
  "policyId": "pol_bella",
  "animalId": "ani_bella",
  "market": "SE",
  "currency": "SEK",
  "channel": "clinic_direct",
  "treatmentFrom": "2026-11-11",
  "treatmentTo": "2026-11-11",
  "diagnosisCode": "ORA-OTIT",
  "lines": [
    { "id": "l1", "description": "Undersökning", "category": "examination", "amount": 65000 },
    { "id": "l2", "description": "Öronsköljning och läkemedel", "category": "medication", "amount": 335000 }
  ]
}

###############################################################################
# 3. Korsbandsskada: går till handläggare.
#    Väntat: decision = null, assessment.mode = manual. RIDER = review
#    (förbehåll i samma diagnosgrupp) och beloppet är över gränsen för automatik.
###############################################################################

# @name korsband
POST {{base}}/v1/claims
Authorization: Bearer {{clinic}}
Content-Type: application/json
Idempotency-Key: {{$guid}}
Accept-Language: sv

{
  "id": "clm_korsband_{{$randomInt 100000 999999}}",
  "claimNo": "EX-KORS-{{$randomInt 1000 9999}}",
  "policyId": "pol_bella",
  "animalId": "ani_bella",
  "market": "SE",
  "currency": "SEK",
  "channel": "clinic_direct",
  "treatmentFrom": "2026-11-11",
  "treatmentTo": "2026-11-13",
  "diagnosisCode": "ORT-KORSBAND-V",
  "lines": [
    { "id": "l1", "description": "Undersökning ortopedi", "category": "examination", "amount": 85000 },
    { "id": "l2", "description": "Röntgen bakben", "category": "diagnostics", "amount": 290000 },
    { "id": "l3", "description": "Sedering och anestesi", "category": "anaesthesia", "amount": 124000 },
    { "id": "l4", "description": "Operation TPLO vänster", "category": "surgery", "amount": 1240000 },
    { "id": "l5", "description": "Smärtlindring 10 dagar", "category": "medication", "amount": 83000 },
    { "id": "l6", "description": "Specialfoder", "category": "food", "amount": 42000 }
  ]
}

###############################################################################
# 4. Handläggaren tittar på bedömningen.
###############################################################################

# @name bedomning
GET {{base}}/v1/claims/{{korsband.response.body.claim.id}}/assessment
Authorization: Bearer {{handler}}
Accept-Language: sv

###############################################################################
# 5. Handläggaren godkänner, med inputHash från bedömningen ovan.
#    Ändras underlaget innan beslutet blir svaret 409.
###############################################################################

POST {{base}}/v1/claims/{{korsband.response.body.claim.id}}/decisions
Authorization: Bearer {{handler}}
Content-Type: application/json
Idempotency-Key: {{$guid}}

{
  "action": "accept",
  "reason": "Förbehållet gäller höger bakben, skadan är på vänster.",
  "expectedInputHash": "{{bedomning.response.body.inputHash}}"
}

###############################################################################
# 6. Alla beslut för ärendet, äldst först.
###############################################################################

GET {{base}}/v1/claims/{{korsband.response.body.claim.id}}/decisions
Authorization: Bearer {{handler}}

###############################################################################
# 7. Försäkringsbelopp: förbrukat och kvar för Bella i år.
###############################################################################

GET {{base}}/v1/policies/pol_bella/animals/ani_bella/limits?onDate=2026-11-11
Authorization: Bearer {{handler}}

###############################################################################
# 8. Omprövning, t.ex. efter en retroaktiv ändring av försäkringen.
#    Har underlaget ändrats blir det ett nytt beslut, och ledgern bokar bara
#    skillnaden. Efter steg 5 har korsbandsbeslutet förbrukat mer av
#    försäkringsbeloppet, så du får 201 med samma ersättning (skillnad 0 kr).
#    Kör samma omprövning igen: nu är underlaget oförändrat och svaret 204.
###############################################################################

POST {{base}}/v1/claims/{{otit.response.body.claim.id}}/reassessments
Authorization: Bearer {{handler}}
Content-Type: application/json
Idempotency-Key: {{$guid}}

{ "reason": "Försäkringen har ändrats retroaktivt." }

###############################################################################
# Felfall
###############################################################################

### Behandling före försäkringsårets start: avslag föreslås (POLICY_FOUND = fail).
POST {{base}}/v1/claim-previews
Authorization: Bearer {{clinic}}
Content-Type: application/json
Accept-Language: sv

{
  "id": "clm_fore_start",
  "claimNo": "PREVIEW-2",
  "policyId": "pol_bella",
  "animalId": "ani_bella",
  "market": "SE",
  "currency": "SEK",
  "channel": "customer",
  "treatmentFrom": "2026-03-20",
  "treatmentTo": "2026-03-20",
  "diagnosisCode": "GI-ENTERIT",
  "lines": [{ "id": "l1", "description": "Undersökning", "category": "examination", "amount": 80000 }]
}

### Kliniken får inte fatta beslut: 403.
POST {{base}}/v1/claims/{{korsband.response.body.claim.id}}/decisions
Authorization: Bearer {{clinic}}
Content-Type: application/json
Idempotency-Key: {{$guid}}

{ "action": "accept" }

### Utan Idempotency-Key: 422.
POST {{base}}/v1/claims/{{korsband.response.body.claim.id}}/decisions
Authorization: Bearer {{handler}}
Content-Type: application/json

{ "action": "accept" }

### Fält som inte finns i kontraktet: 422 med fältfel.
POST {{base}}/v1/claim-previews
Authorization: Bearer {{clinic}}
Content-Type: application/json

{ "id": "x", "okäntFält": true }

### Okänt ärende: 404.
GET {{base}}/v1/claims/clm_finns_inte
Authorization: Bearer {{handler}}

### Utan token: 401.
GET {{base}}/v1/claims/clm_finns_inte
