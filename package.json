{
  "name": "petvold",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "modules/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "node --import tsx --test \"modules/*/test/*.test.ts\"",
    "test:db": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 \"db/test/*.test.ts\" \"modules/*/test-db/*.test.ts\"",
    "lint:openapi": "tsx modules/api/scripts/check-contract.ts",
    "dev": "tsx watch modules/api/src/dev-server.ts",
    "dev:up": "docker compose up -d --wait && npm run db:migrate",
    "dev:down": "docker compose down",
    "dev:reset": "docker compose down -v && npm run dev:up",
    "db:migrate": "dbmate --wait --no-dump-schema up && dbmate --env TEST_DATABASE_URL --wait --no-dump-schema up",
    "db:new": "dbmate new",
    "lint:lang": "tsx scripts/check-language.ts",
    "scenarios:golden": "tsx scripts/scenarios-golden.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "dbmate": "^2.38.1",
    "fast-check": "^4.10.2",
    "pg": "^8.23.1",
    "tsx": "^4",
    "typescript": "^5.9",
    "yaml": "^2.9.1"
  }
}
