{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["modules/*/src/**/*.ts", "modules/*/test/**/*.ts", "modules/*/scripts/**/*.ts", "modules/*/test-suites/**/*.ts", "modules/*/test-db/**/*.ts", "db/test/**/*.ts"]
}
